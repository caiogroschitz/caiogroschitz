# Sistema Editorial Jurídico — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais

# Obrigatório: Chave da API da Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: Credenciais do Jusbrasil (para o MCP de jurisprudência real)
JUSBRASIL_EMAIL=seu@email.com
JUSBRASIL_PASSWORD=sua_senha

# Opcional: Configurações de log
LOG_LEVEL=INFO
LOG_DIR=logs
